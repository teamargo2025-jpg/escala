# Copiar como .env.local (no se sube a GitHub) y llenar con los datos de Supabase:
# Supabase → Project Settings → API Keys.
# Sin estas variables la app funciona en "modo prueba" (cuentas solo en el navegador).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
